<?xml version="1.0" encoding="UTF-8"?>

<?import com.jfoenix.controls.JFXButton?>
<?import com.jfoenix.controls.JFXComboBox?>
<?import com.jfoenix.controls.JFXRadioButton?>
<?import com.jfoenix.controls.JFXTextField?>
<?import java.lang.String?>
<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<?import np.com.spirrotech.library.toolbar.ToolBar?>

<BorderPane fx:id="root" xmlns="http://javafx.com/javafx/8.0.141" xmlns:fx="http://javafx.com/fxml/1" fx:controller="np.com.spirrotech.application.credit_billing.CreditBillingController">
    <center>
        <VBox style="-fx-background-color: linear-gradient(from 0% 0% to 100% 100%,#ffffff,#aaaaaa);" BorderPane.alignment="CENTER">
            <children>
                <HBox alignment="CENTER" spacing="20.0">
                    <children>
                        <JFXRadioButton fx:id="diesel" text="Diesel">
                            <font>
                                <Font size="25.0" />
                            </font>
                            <toggleGroup>
                                <ToggleGroup fx:id="selection" />
                            </toggleGroup>
                        </JFXRadioButton>
                        <JFXRadioButton fx:id="petrol" text="Petrol" toggleGroup="$selection">
                            <font>
                                <Font size="25.0" />
                            </font>
                        </JFXRadioButton>
                        <JFXRadioButton fx:id="extra" text="Extra" toggleGroup="$selection">
                            <font>
                                <Font size="25.0" />
                            </font>
                        </JFXRadioButton>
                    </children>
                    <padding>
                        <Insets bottom="15.0" top="15.0" />
                    </padding>
                </HBox>
                <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0">
                    <VBox.margin>
                        <Insets top="15.0" />
                    </VBox.margin>
               <children>
                  <JFXComboBox fx:id="companyName" labelFloat="true" promptText="Select Company Name" unFocusColor="#28e11e">
                     <stylesheets>
                        <URL value="@../../css/appColorPalette.css" />
                        <URL value="@../../css/componentStyles.css" />
                     </stylesheets>
                     <styleClass>
                        <String fx:value="inputTextFieldColor" />
                        <String fx:value="inputTextField" />
                     </styleClass></JFXComboBox>
               </children>
                </HBox>
                <StackPane>
                    <children>
                        <VBox fx:id="dieselPetrol" alignment="CENTER" spacing="20.0">
                            <children>
                                <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0">
                                    <children>
                                        <JFXTextField fx:id="vehicleNumber" labelFloat="true" promptText="Vehicle Number" unFocusColor="#2af12a">
                                            <font>
                                                <Font size="25.0" />
                                            </font>
                                            <HBox.margin>
                                                <Insets />
                                            </HBox.margin>
                                 <stylesheets>
                                    <URL value="@../../css/appColorPalette.css" />
                                    <URL value="@../../css/componentStyles.css" />
                                 </stylesheets>
                                 <styleClass>
                                    <String fx:value="inputTextFieldColor" />
                                    <String fx:value="inputTextField" />
                                 </styleClass>
                                        </JFXTextField>
                                    </children>
                                    <VBox.margin>
                                        <Insets />
                                    </VBox.margin>
                                    <padding>
                                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                                    </padding>
                                </HBox>
                                <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0">
                                    <children>
                                        <JFXTextField fx:id="volume" labelFloat="true" promptText="Volume" unFocusColor="#2af12a">
                                            <font>
                                                <Font size="25.0" />
                                            </font>
                                 <stylesheets>
                                    <URL value="@../../css/appColorPalette.css" />
                                    <URL value="@../../css/componentStyles.css" />
                                 </stylesheets>
                                 <styleClass>
                                    <String fx:value="inputTextField" />
                                    <String fx:value="inputTextFieldColor" />
                                 </styleClass>
                                        </JFXTextField>

                                    </children>
                                    <VBox.margin>
                                        <Insets top="15.0" />
                                    </VBox.margin>
                                    <padding>
                                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                                    </padding>
                                </HBox>
                                <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0">
                                    <children>
                                        <JFXTextField fx:id="price" labelFloat="true" promptText="Price" unFocusColor="#2af12a">
                                            <font>
                                                <Font size="25.0" />
                                            </font>
                                 <stylesheets>
                                    <URL value="@../../css/appColorPalette.css" />
                                    <URL value="@../../css/componentStyles.css" />
                                 </stylesheets>
                                 <styleClass>
                                    <String fx:value="inputTextField" />
                                    <String fx:value="inputTextFieldColor" />
                                 </styleClass>
                                        </JFXTextField>
                                    </children>
                                    <VBox.margin>
                                        <Insets top="15.0" />
                                    </VBox.margin>
                                    <padding>
                                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                                    </padding>
                                </HBox>
                            </children>
                        </VBox>
                        <VBox fx:id="extraBill" alignment="CENTER" spacing="20.0" visible="false">
                            <children>
                                <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0">
                                    <children>
                                        <JFXTextField fx:id="itemName" labelFloat="true" promptText="Item Name" unFocusColor="#2af12a">
                                            <font>
                                                <Font size="25.0" />
                                            </font>
                                            <HBox.margin>
                                                <Insets />
                                            </HBox.margin>
                                            <stylesheets>
                                                <URL value="@../../css/appColorPalette.css" />
                                                <URL value="@../../css/componentStyles.css" />
                                            </stylesheets>
                                            <styleClass>
                                                <String fx:value="inputTextFieldColor" />
                                                <String fx:value="inputTextField" />
                                            </styleClass>
                                        </JFXTextField>
                                    </children>
                                    <VBox.margin>
                                        <Insets />
                                    </VBox.margin>
                                    <padding>
                                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                                    </padding>
                                </HBox>
                                <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0">
                                    <children>
                                        <JFXTextField fx:id="quantity" labelFloat="true" promptText="Quantity" unFocusColor="#2af12a">
                                            <font>
                                                <Font size="25.0" />
                                            </font>
                                            <stylesheets>
                                                <URL value="@../../css/appColorPalette.css" />
                                                <URL value="@../../css/componentStyles.css" />
                                            </stylesheets>
                                            <styleClass>
                                                <String fx:value="inputTextFieldColor" />
                                                <String fx:value="inputTextField" />
                                            </styleClass>
                                        </JFXTextField>
                                    </children>
                                    <VBox.margin>
                                        <Insets top="15.0" />
                                    </VBox.margin>
                                    <padding>
                                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                                    </padding>
                                </HBox>
                                <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0">
                                    <children>
                                        <JFXTextField fx:id="rates" labelFloat="true" promptText="Rate" unFocusColor="#2af12a">
                                            <font>
                                                <Font size="25.0" />
                                            </font>
                                            <stylesheets>
                                                <URL value="@../../css/appColorPalette.css" />
                                                <URL value="@../../css/componentStyles.css" />
                                            </stylesheets>
                                            <styleClass>
                                                <String fx:value="inputTextFieldColor" />
                                                <String fx:value="inputTextField" />
                                            </styleClass>
                                        </JFXTextField>
                                    </children>
                                    <VBox.margin>
                                        <Insets top="15.0" />
                                    </VBox.margin>
                                    <padding>
                                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                                    </padding>
                                </HBox>
                            </children>
                        </VBox>
                    </children>
                    <VBox.margin>
                        <Insets top="15.0" />
                    </VBox.margin>
                </StackPane>
                <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0">
                    <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                    </padding>
                    <children>
                        <TextField fx:id="total" editable="false" promptText="Total">
                            <font>
                                <Font size="25.0" />
                            </font>
                        </TextField>
                    </children>
                    <VBox.margin>
                        <Insets top="15.0" />
                    </VBox.margin>
                </HBox>
                <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" spacing="30.0">
                    <children>
                        <JFXButton fx:id="save" buttonType="RAISED" onMouseClicked="#saveBill" text="SAVE">
                            <font>
                                <Font size="25.0" />
                            </font>
                     <stylesheets>
                        <URL value="@../../css/appColorPalette.css" />
                        <URL value="@../../css/componentStyles.css" />
                     </stylesheets>
                     <styleClass>
                        <String fx:value="addButtonColor" />
                        <String fx:value="generalButton" />
                     </styleClass>
                        </JFXButton>
                  <JFXButton fx:id="print" buttonType="RAISED" onMouseClicked="#printBill" text="PRINT">
                     <font>
                        <Font size="25.0" />
                     </font>
                     <stylesheets>
                        <URL value="@../../css/appColorPalette.css" />
                        <URL value="@../../css/componentStyles.css" />
                     </stylesheets>
                     <styleClass>
                        <String fx:value="generalButtonColor" />
                        <String fx:value="generalButton" />
                     </styleClass>
                  </JFXButton>
                    </children>
                </HBox>
            </children>
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
        </VBox>
    </center>
    <left>
        <ListView fx:id="transactionListView" prefWidth="300.0" BorderPane.alignment="CENTER" />
    </left>
    <right>
        <VBox alignment="CENTER" prefWidth="300.0" spacing="50.0" BorderPane.alignment="CENTER">
            <children>
            <JFXButton fx:id="adminButton" buttonType="RAISED" layoutX="20.0" layoutY="175.0" onMouseClicked="#loadAdmin" prefHeight="80.0" prefWidth="80.0">
               <stylesheets>
                  <URL value="@../../css/componentStyles.css" />
                  <URL value="@../../css/appColorPalette.css" />
               </stylesheets>
               <styleClass>
                  <String fx:value="billingRoundButton" />
                  <String fx:value="adminButtonColor" />
                   <String fx:value="adminButtonIcon" />
               </styleClass>
            </JFXButton>
                <JFXButton fx:id="itemsCount" buttonType="RAISED" prefHeight="80.0" prefWidth="80.0" style="-fx-text-fill: white; -fx-font-weight: bold;" text="0">
                    <font>
                        <Font size="25.0" />
                    </font>
               <stylesheets>
                  <URL value="@../../css/appColorPalette.css" />
                  <URL value="@../../css/componentStyles.css" />
               </stylesheets>
               <styleClass>
                  <String fx:value="countButtonColor" />
                  <String fx:value="billingRoundButton" />
               </styleClass>
                </JFXButton>
                <JFXButton fx:id="addItems" buttonType="RAISED" onMouseClicked="#addNewItem" prefHeight="80.0" prefWidth="80.0">
               <stylesheets>
                  <URL value="@../../css/componentStyles.css" />
                  <URL value="@../../css/appColorPalette.css" />
               </stylesheets>
               <styleClass>
                  <String fx:value="addButtonColor" />
                   <String fx:value="addButtonIcon" />
                  <String fx:value="billingRoundButton" />
               </styleClass>
                </JFXButton>
                <JFXButton buttonType="RAISED" onMouseClicked="#deleteItem" prefHeight="80.0" prefWidth="80.0">
               <stylesheets>
                  <URL value="@../../css/componentStyles.css" />
                  <URL value="@../../css/appColorPalette.css" />
               </stylesheets>
               <styleClass>
                  <String fx:value="removeButtonColor" />
                   <String fx:value="removeButtonIcon" />
                  <String fx:value="billingRoundButton" />
               </styleClass>
                </JFXButton>
                <JFXButton buttonType="RAISED" onMouseClicked="#clearSelection" prefHeight="80.0" prefWidth="80.0">
               <stylesheets>
                  <URL value="@../../css/componentStyles.css" />
                  <URL value="@../../css/appColorPalette.css" />
               </stylesheets>
               <styleClass>
                  <String fx:value="clearButtonColor" />
                   <String fx:value="clearButtonIcon" />
                  <String fx:value="billingRoundButton" />
               </styleClass>
                </JFXButton>
            </children>
         <padding>
            <Insets bottom="50.0" left="50.0" right="50.0" top="50.0" />
         </padding>
        </VBox>
    </right>
    <top>
        <ToolBar fx:id="toolBar" />
    </top>
</BorderPane>
