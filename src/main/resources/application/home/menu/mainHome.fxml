                  <HBox alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" styleClass="gridMenuItems" stylesheets="@../../../../java/np/com/spirrotech/css/mainHomeStyle.css" VBox.vgrow="ALWAYS">
                     <children>
                        <ImageView fitHeight="135.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true" HBox.hgrow="NEVER">
