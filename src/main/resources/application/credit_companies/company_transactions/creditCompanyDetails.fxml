<?xml version="1.0" encoding="UTF-8"?>

<?import com.jfoenix.controls.JFXButton?>
<?import java.lang.String?>
<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<?import np.com.spirrotech.library.toolbar.ToolBar?>
<?import np.com.spirrotech.library.output_task_loading.OutputTaskLoading?>

<BorderPane xmlns="http://javafx.com/javafx/8.0.162-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="np.com.spirrotech.application.credit_companies.company_transactions.CreditCompanyDetailsController">
   <top>

       <ToolBar fx:id="toolBar"/>
   </top>

    <center>
      <StackPane BorderPane.alignment="CENTER">
         <children>
            <VBox alignment="TOP_CENTER" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308">
               <children>
                  <TableView fx:id="detailsTableView" editable="true" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" stylesheets="@../../../css/tableView.css" VBox.vgrow="ALWAYS">
                     <columns>
                        <TableColumn fx:id="sn" editable="false" maxWidth="-1.0" minWidth="50.0" prefWidth="-1.0" text="S.N" />
                        <TableColumn fx:id="itemName" minWidth="100.0" prefWidth="100.0" text="Item Name" />
                        <TableColumn fx:id="vehicleNo" minWidth="100.0" prefWidth="100.0" text="Vehicle NO" />
                        <TableColumn fx:id="rate" minWidth="100.0" prefWidth="100.0" text="Rate" />
                        <TableColumn fx:id="quantity" minWidth="100.0" prefWidth="100.0" text="Quantity" />
                        <TableColumn fx:id="price" minWidth="100.0" prefWidth="100.0" text="Price" />
                        <TableColumn fx:id="date" minWidth="100.0" prefWidth="100.0" text="Date" />
                     </columns>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                  </TableView>
                  <HBox alignment="CENTER" VBox.vgrow="NEVER">
                     <children>
                        <JFXButton buttonType="RAISED" onMouseClicked="#deleteTransaction" prefHeight="80.0" prefWidth="80.0">
                           <stylesheets>
                              <URL value="@../../../css/componentStyles.css" />
                              <URL value="@../../../css/appColorPalette.css" />
                           </stylesheets>
                           <styleClass>
                              <String fx:value="clearButtonColor" />
                              <String fx:value="clearButtonIcon" />
                              <String fx:value="billingRoundButton" />
                           </styleClass>
                        </JFXButton>
                     </children>
                     <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                     </padding>
                  </HBox>
               </children>
            </VBox>
            <OutputTaskLoading fx:id="progressLayout" />
         </children>
      </StackPane>
   </center>
</BorderPane>
