<?xml version="1.0" encoding="UTF-8"?>

<?import com.jfoenix.controls.JFXButton?>
<?import java.lang.String?>
<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<?import sample.library.toolbar.ToolBar?>

<?import sample.library.output_task_loading.OutputTaskLoading?>

<BorderPane xmlns="http://javafx.com/javafx/8.0.141" xmlns:fx="http://javafx.com/fxml/1" fx:controller="sample.controller.main_home_controller.DailyTotalAnalyticsController">
   <center>
      <StackPane BorderPane.alignment="CENTER">
         <children>
            <VBox fx:id="dailyTotalAnalyticsLayout" visible="false">
               <children>
                  <HBox alignment="CENTER">
                     <children>
                        <JFXButton buttonType="RAISED" onMouseClicked="#showTodayAnalytics" text="TODAY ANALYTICS">
                           <font>
                              <Font size="25.0" />
                           </font>
                           <stylesheets>
                              <URL value="@../../css/appColorPalette.css" />
                              <URL value="@../../css/componentStyles.css" />
                           </stylesheets>
                           <styleClass>
                              <String fx:value="generalButton" />
                              <String fx:value="generalButtonColor" />
                           </styleClass>
                        </JFXButton>
                     </children>
                     <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                     </padding>
                  </HBox>
                  <TableView fx:id="tableView" VBox.vgrow="ALWAYS">
                     <columns>
                        <TableColumn fx:id="iDieselVol" minWidth="75.0" prefWidth="100.0" text="I.Diesel Vol" />
                        <TableColumn fx:id="iPetrolVol" minWidth="75.0" prefWidth="100.0" text="I.Petrol Vol" />
                        <TableColumn fx:id="cDieselVol" prefWidth="100.0" text="C.Diesel Vol" />
                        <TableColumn fx:id="cPetrolVol" prefWidth="100.0" text="C.Petrol Vol" />
                        <TableColumn fx:id="extraIncome" prefWidth="100.0" text="Extra " />
                        <TableColumn fx:id="oilIncome" prefWidth="100.0" text="Oil" />
                        <TableColumn fx:id="total" prefWidth="100.0" text="Total" />
                        <TableColumn fx:id="date" prefWidth="100.0" text="Date" />
                     </columns>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                  </TableView>
               </children>
            </VBox>
            <OutputTaskLoading fx:id="progressLayout" />
         </children>
      </StackPane>
   </center>

    <top>
        <ToolBar fx:id="toolBar"/>
    </top>
</BorderPane>
