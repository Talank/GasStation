<?xml version="1.0" encoding="UTF-8"?>

<?import com.jfoenix.controls.JFXButton?>

<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<?import sample.library.toolbar.ToolBar?>

<?import sample.library.output_task_loading.OutputTaskLoading?>
<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="800.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/8.0.141" xmlns:fx="http://javafx.com/fxml/1" fx:controller="sample.controller.main_home_controller.DailyTotalAnalyticsController">
   <center>
      <StackPane prefHeight="150.0" prefWidth="200.0" BorderPane.alignment="CENTER">
         <children>
            <VBox fx:id="dailyTotalAnalyticsLayout" prefHeight="200.0" prefWidth="100.0" visible="false">
               <children>
                  <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0">
                     <children>
                        <JFXButton buttonType="RAISED" onMouseClicked="#showTodayAnalytics" style="-fx-background-color: #20e475;" text="TODAY ANALYTICS">
                           <font>
                              <Font size="25.0" />
                           </font>
                        </JFXButton>
                     </children>
                  </HBox>
                  <TableView fx:id="tableView" VBox.vgrow="ALWAYS">
                     <columns>
                        <TableColumn fx:id="iDieselVol" minWidth="75.0" prefWidth="100.0" text="I.Diesel Vol" />
                        <TableColumn fx:id="iPetrolVol" minWidth="75.0" prefWidth="100.0" text="I.Petrol Vol" />
                        <TableColumn fx:id="cDieselVol" prefWidth="100.0" text="C.Diesel Vol" />
                        <TableColumn fx:id="cPetrolVol" prefWidth="100.0" text="C.Petrol Vol" />
                        <TableColumn fx:id="extraIncome" prefWidth="100.0" text="Extra " />
                        <TableColumn fx:id="oilIncome" prefWidth="100.0" text="Oil" />
                        <TableColumn fx:id="total" prefWidth="100.0" text="Total" />
                        <TableColumn fx:id="date" prefWidth="100.0" text="Date" />
                     </columns>
                  </TableView>
               </children>
            </VBox>
            <OutputTaskLoading fx:id="progressLayout" />
         </children>
      </StackPane>
   </center>

    <top>
        <ToolBar fx:id="toolBar"/>
    </top>
</BorderPane>
