<?xml version="1.0" encoding="UTF-8"?>

<?import com.jfoenix.controls.JFXButton?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<?import sample.library.toolbar.ToolBar?>

<?import sample.library.output_task_loading.OutputTaskLoading?>
<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="800.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/8.0.141" xmlns:fx="http://javafx.com/fxml/1" fx:controller="sample.controller.main_home_controller.ProfitLossController">
   <center>
      <StackPane prefHeight="150.0" prefWidth="200.0" BorderPane.alignment="CENTER">
         <children>
            <VBox fx:id="profitLossLayout" prefHeight="200.0" prefWidth="100.0">
               <children>
                  <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0">
                     <children>
                        <JFXButton fx:id="reFill" buttonType="RAISED" onMouseClicked="#loadRefillChange" style="-fx-background-color: #3af450;" text="ReFill">
                           <font>
                              <Font size="25.0" />
                           </font>
                        </JFXButton>
                     </children>
                  </HBox>
                  <TableView fx:id="tableView" prefHeight="200.0" prefWidth="200.0" VBox.vgrow="ALWAYS">
                     <columns>
                        <TableColumn fx:id="expectedDiesel" prefWidth="75.0" text="E.Diesel Vol" />
                        <TableColumn fx:id="actualDiesel" prefWidth="75.0" text="A.Diesel Vol" />
                        <TableColumn fx:id="dieselLoss" prefWidth="75.0" text="Diesel Loss" />
                        <TableColumn fx:id="expectedPetrol" prefWidth="75.0" text="E.Petrol Vol" />
                        <TableColumn fx:id="actualPetrol" prefWidth="75.0" text="A.Petrol Vol" />
                        <TableColumn fx:id="petrolLoss" prefWidth="75.0" text="Petrol Loss" />
                        <TableColumn fx:id="date" prefWidth="75.0" text="Date" />
                     </columns>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                  </TableView>
               </children>
            </VBox>

             <OutputTaskLoading fx:id="progressLayout" />
         </children>
      </StackPane>
   </center>

    <top>
        <ToolBar fx:id="toolBar" />
    </top>
</BorderPane>
