<?xml version="1.0" encoding="UTF-8"?>

<?import com.jfoenix.controls.JFXButton?>
<?import com.jfoenix.controls.JFXRadioButton?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<?import sample.library.toolbar.ToolBar?>
<?import sample.library.output_task_loading.OutputTaskLoading?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="800.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/8.0.141" xmlns:fx="http://javafx.com/fxml/1" fx:controller="sample.controller.main_home_controller.ProfitLossController">
   <center>
      <StackPane prefHeight="150.0" prefWidth="200.0" BorderPane.alignment="CENTER">
         <children>
            <VBox fx:id="profitLossLayout">
               <children>
                  <VBox alignment="CENTER" prefHeight="200.0" prefWidth="100.0" spacing="20.0">
                     <children>
                        <JFXButton fx:id="reFill" buttonType="RAISED" onMouseClicked="#loadRefillChange" style="-fx-background-color: #3af450;" text="ReFill">
                           <font>
                              <Font size="25.0" />
                           </font>
                        </JFXButton>
                        <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" spacing="50.0">
                           <children>
                              <JFXRadioButton fx:id="dieselButton" selected="true" text="Diesel">
                                 <font>
                                    <Font name="System Bold" size="20.0" />
                                 </font>
                                 <toggleGroup>
                                    <ToggleGroup fx:id="selection" />
                                 </toggleGroup>
                              </JFXRadioButton>
                              <JFXRadioButton fx:id="petrolButton" text="Petrol" toggleGroup="$selection">
                                 <font>
                                    <Font name="System Bold" size="20.0" />
                                 </font>
                              </JFXRadioButton>
                           </children>
                        </HBox>
                     </children>
                  </VBox>
                  <StackPane VBox.vgrow="ALWAYS">
                     <children>
                        <TableView fx:id="dieselTable">
                           <columns>
                              <TableColumn fx:id="dieselExpected" prefWidth="75.0" text="Expected Vol" />
                              <TableColumn fx:id="dieselActual" prefWidth="75.0" text="Actual Vol" />
                              <TableColumn fx:id="dieselLoss" prefWidth="75.0" text="Loss" />
                              <TableColumn fx:id="dieselDate" prefWidth="75.0" text="Date" />
                           </columns>
                           <columnResizePolicy>
                              <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                           </columnResizePolicy>
                        </TableView>
                        <TableView fx:id="petrolTable" layoutX="10.0" layoutY="10.0" visible="false">
                           <columns>
                              <TableColumn fx:id="petrolExpected" prefWidth="75.0" text="Expected Vol" />
                              <TableColumn fx:id="petrolActual" prefWidth="75.0" text="Actual Vol" />
                              <TableColumn fx:id="petrolLoss" prefWidth="75.0" text="Loss" />
                              <TableColumn fx:id="petrolDate" prefWidth="75.0" text="Date" />
                           </columns>
                           <columnResizePolicy>
                              <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                           </columnResizePolicy>
                        </TableView>
                     </children>
                  </StackPane>
               </children>
            </VBox>

             <OutputTaskLoading fx:id="progressLayout" />
         </children>
      </StackPane>
   </center>

    <top>
        <ToolBar fx:id="toolBar" />
    </top>
</BorderPane>
