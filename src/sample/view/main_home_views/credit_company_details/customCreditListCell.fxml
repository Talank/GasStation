<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox styleClass="listItem" stylesheets="@../../../css/listItemStyle.css" xmlns="http://javafx.com/javafx/8.0.141" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <HBox VBox.vgrow="NEVER">
         <children>
            <Label fx:id="transactionDate" text="Transaction Date:">
               <font>
                  <Font name="System Bold" size="25.0" />
               </font>
            </Label>
         </children>
         <padding>
            <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
         </padding>
      </HBox>
      <TableView fx:id="tableView" prefHeight="180.0" VBox.vgrow="ALWAYS">
        <columns>
          <TableColumn fx:id="itemName" editable="false" minWidth="100.0" prefWidth="100.0" text="Item Name" />
          <TableColumn fx:id="vehicleNo" editable="false" minWidth="100.0" prefWidth="100.0" text="Vehicle NO" />
            <TableColumn fx:id="rate" editable="false" minWidth="100.0" prefWidth="100.0" text="Rate" />
            <TableColumn fx:id="quantity" editable="false" minWidth="100.0" prefWidth="100.0" text="Quantity" />
            <TableColumn fx:id="price" editable="false" minWidth="100.0" prefWidth="100.0" text="Price" />
        </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
      <HBox VBox.vgrow="NEVER">
         <children>
            <Label fx:id="total" text="Total:">
               <font>
                  <Font name="System Bold" size="25.0" />
               </font>
               <padding>
                  <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
               </padding>
            </Label>
         </children>
      </HBox>
   </children>
   <padding>
      <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
   </padding>
</VBox>
